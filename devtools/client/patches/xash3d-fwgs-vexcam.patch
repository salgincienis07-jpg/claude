+/*
+==============
+R_SpeedsDump_f
+
+vexmira render client patch: one parseable line with the counters of the last frame that
+drew the world (needs r_speeds > 0, otherwise the counters are never reset) and the average
+frame rate since the previous dump.
+==============
+*/
+static ref_speeds_t r_stats_last;
+static int r_last_ents, r_last_srvents;
+static uint r_dump_frames;
+static double r_dump_start = -1.0;
+
+// per studio model breakdown of epoly ("r_speeds_dump models"): triangles and entity count
+// per model file in the current frame; copied together with r_stats at the end of a world frame
+#define R_MDLSTATS_MAX 192
+typedef struct
+{
+	char name[64];
+	uint tris;
+	uint ents;
+	const cl_entity_t *last_ent;
+} r_mdlstat_t;
+
+static r_mdlstat_t r_mdl_cur[R_MDLSTATS_MAX], r_mdl_last[R_MDLSTATS_MAX];
+static int r_mdl_numcur, r_mdl_numlast;
+
+void R_SpeedsCountModel( const char *name, const cl_entity_t *ent, int tris )
+{
+	int i;
+
+	for( i = 0; i < r_mdl_numcur; i++ )
+	{
+		if( !Q_strncmp( r_mdl_cur[i].name, name, sizeof( r_mdl_cur[i].name )))
+			break;
+	}
+
+	if( i == r_mdl_numcur )
+	{
+		if( r_mdl_numcur >= R_MDLSTATS_MAX )
+			return;
+		r_mdl_numcur++;
+		memset( &r_mdl_cur[i], 0, sizeof( r_mdl_cur[i] ));
+		Q_strncpy( r_mdl_cur[i].name, name, sizeof( r_mdl_cur[i].name ));
+	}
+
+	r_mdl_cur[i].tris += tris;
+	if( r_mdl_cur[i].last_ent != ent )
+	{
+		r_mdl_cur[i].last_ent = ent;
+		r_mdl_cur[i].ents++;
+	}
+}
+
+static int R_MdlStatCmp( const void *a, const void *b )
+{
+	const r_mdlstat_t *x = a, *y = b;
+	return x->tris < y->tris ? 1 : x->tris > y->tris ? -1 : 0;
+}
+
+void R_SpeedsDump_f( void )
+{
+	double now = gp_host->realtime;
+	double secs = r_dump_start >= 0.0 ? now - r_dump_start : 0.0;
+
+	gEngfuncs.Con_Printf( "R_SPEEDS wpoly=%u epoly=%u spoly=%u apoly=%u leafs=%u studio_drawn=%u sprites_drawn=%u"
+		" statics=%u ents=%i srvents=%i tents=%u beams=%u particles=%u frames=%u secs=%.2f fps=%.1f\n",
+		r_stats_last.c_world_polys, r_stats_last.c_studio_polys, r_stats_last.c_sprite_polys,
+		r_stats_last.c_alias_polys, r_stats_last.c_world_leafs, r_stats_last.c_studio_models_drawn,
+		r_stats_last.c_sprite_models_drawn, r_stats_last.c_client_ents, r_last_ents, r_last_srvents,
+		r_stats_last.c_active_tents_count, r_stats_last.c_view_beams_count, r_stats_last.c_particle_count,
+		r_dump_frames, secs, secs > 0.0 ? r_dump_frames / secs : 0.0 );
+
+	r_dump_frames = 0;
+	r_dump_start = now;
+
+	if( gEngfuncs.Cmd_Argc() > 1 && !Q_stricmp( gEngfuncs.Cmd_Argv( 1 ), "models" ))
+	{
+		r_mdlstat_t sorted[R_MDLSTATS_MAX];
+		int i;
+
+		memcpy( sorted, r_mdl_last, sizeof( r_mdlstat_t ) * r_mdl_numlast );
+		qsort( sorted, r_mdl_numlast, sizeof( r_mdlstat_t ), R_MdlStatCmp );
+		for( i = 0; i < r_mdl_numlast; i++ )
+			gEngfuncs.Con_Printf( "R_MODEL tris=%u ents=%u name=%s\n", sorted[i].tris, sorted[i].ents, sorted[i].name );
+		gEngfuncs.Con_Printf( "R_MODELS_END count=%i\n", r_mdl_numlast );
+	}
+}
