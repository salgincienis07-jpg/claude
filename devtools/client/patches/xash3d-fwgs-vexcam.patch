 	mleaf_t *curleaf = RI.viewleaf ? RI.viewleaf : WORLDMODEL->leafs;
 
+	// vexmira render client patch: keep a copy for r_speeds_dump
+	r_stats_last = r_stats;
+	r_last_ents = r_numEntities - r_numStatics;
+	r_last_srvents = (int)ENGINE_GET_PARM( PARM_NUMENTITIES );
+	r_dump_frames++;
+	if( r_dump_start < 0.0 )
+		r_dump_start = gp_host->realtime;
+
 	switch( (int)r_speeds->value )
 	{
 	case 1:
