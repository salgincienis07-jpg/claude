public plugin_init()
{
    register_plugin("Vexmira Independent Diagnostic", "4.0.2", "Vexmira");
    register_concmd("vex_diagnose", "DiagnosticCommand", ADMIN_RCON);
    set_task(2.0, "StartupDiagnostic");
}
public StartupDiagnostic() { Diagnose(); }
public DiagnosticCommand(id)
{
    if(id && !(get_user_flags(id)&ADMIN_RCON)) return PLUGIN_HANDLED;
    Diagnose();
    return PLUGIN_HANDLED;
}
stock Report(const format[], any:...)
{
    new text[512]; vformat(text,charsmax(text),format,2);
    server_print("[VexDiag] %s",text);
    log_to_file("vex_diagnostic.log","%s",text);
}
stock Diagnose()
{
    new version[64], map[64]; get_amxx_verstring(version,charsmax(version)); get_mapname(map,charsmax(map));
    Report("BEGIN AMXX=%s MAP=%s",version,map);
    if(contain(version,"1.8.")==0 || contain(version,"1.9.")==0)
        Report("VERSION: Full Community mod targets AMXX 1.10. This diagnostic itself supports 1.8.2.");
    new name[128], author[64], module_version[64], status;
    for(new i;i<get_modulesnum();i++)
    {
        get_module(i,name,charsmax(name),author,charsmax(author),module_version,charsmax(module_version),status);
        Report("MODULE name=%s version=%s status=%d",name,module_version,status);
    }
    new filename[128], plugin_version[64], plugin_status[32], path[192], data, header[4];
    for(new i;i<get_pluginsnum();i++)
    {
        get_plugin(i,filename,charsmax(filename),name,charsmax(name),plugin_version,charsmax(plugin_version),author,charsmax(author),plugin_status,charsmax(plugin_status));
        if(containi(filename,"vex")==-1) continue;
        formatex(path,charsmax(path),"addons/amxmodx/plugins/%s",filename);
        new fp=fopen(path,"rb");
        if(fp)
        {
            for(new j;j<4;j++) { data=0; fread(fp,data,BLOCK_BYTE); header[j]=data&255; }
            fclose(fp);
            Report("PLUGIN file=%s status=%s bytes=%d header=%02X %02X %02X %02X",filename,plugin_status,file_size(path),header[0],header[1],header[2],header[3]);
            if(header[0]!=0x58 || header[1]!=0x58 || header[2]!=0x4D || header[3]!=0x41)
                Report("BAD HEADER: %s is not a standard compressed AMXX file. Compare the actual uploaded bytes.",filename);
        }
        else Report("PLUGIN file=%s status=%s FILE_NOT_READABLE",filename,plugin_status);
    }
    new missing, size_errors;
    for(new i;i<sizeof ASSETS;i++)
    {
        if(!file_exists(ASSETS[i]))
        {
            missing++;
            Report("MISSING %s",ASSETS[i]);
        }
        else if(file_size(ASSETS[i])!=ASSET_BYTES[i])
        {
            size_errors++;
            Report("SIZE_MISMATCH %s bytes=%d expected=%d",ASSETS[i],file_size(ASSETS[i]),ASSET_BYTES[i]);
        }
    }
    if(!file_exists("addons/amxmodx/configs/vexmira.cfg")) Report("MISSING configs/vexmira.cfg");
    if(!file_exists("addons/amxmodx/data/lang/vexmira_zombie.txt")) Report("MISSING data/lang/vexmira_zombie.txt");
    Report("ASSETS checked=%d missing=%d size_mismatch=%d",sizeof ASSETS,missing,size_errors);
    Report("END. Also capture: meta list; amxx version; amxx plugins. This checks files, not live gameplay.");
}
